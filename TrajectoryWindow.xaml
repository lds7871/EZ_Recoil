<Window x:Class="EZRecoil.TrajectoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轨迹图 - EZ_Recoil"
        Icon="pack://application:,,,/EZ_Recoil.ico"
        Width="640"
        Height="680"
        MinWidth="460"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 参数摘要 -->
    <Border Grid.Row="0"
            Padding="10"
            CornerRadius="6"
            Background="#2B2B2B">
      <StackPanel>
        <TextBlock x:Name="SummaryText"
                   Foreground="#DDDDDD"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="EndpointText"
                   Foreground="#AAAAAA"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>
        <TextBlock Text=" "
                   Foreground="#888888"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>
        <TextBlock x:Name="RadHintText"
                   Foreground="#FFD54F"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <!-- 轨迹画布 -->
    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Background="White"
            BorderBrush="#CCCCCC"
            BorderThickness="1">
      <Canvas x:Name="ChartCanvas"
              ClipToBounds="True"
              SizeChanged="ChartCanvas_SizeChanged"/>
    </Border>

    <!-- 图例 -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,10,0,0">
      <Rectangle Width="20"
                 Height="4"
                 Fill="#E53935"
                 VerticalAlignment="Center"/>
      <TextBlock Text="正向"
                 Margin="6,0,18,0"
                 VerticalAlignment="Center"/>
      <Rectangle Width="20"
                 Height="4"
                 Fill="#2E7D32"
                 VerticalAlignment="Center"/>
      <TextBlock Text="反向"
                 Margin="6,0,18,0"
                 VerticalAlignment="Center"/>
      <Ellipse Width="11"
               Height="11"
               Fill="White"
               Stroke="#424242"
               StrokeThickness="2"
               VerticalAlignment="Center"/>
      <TextBlock Text="起点"
                 Margin="6,0,18,0"
                 VerticalAlignment="Center"/>
      <TextBlock x:Name="ScaleText"
                 Foreground="#666666"
                 VerticalAlignment="Center"/>
    </StackPanel>
  </Grid>
</Window>
